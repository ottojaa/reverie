# Database
DATABASE_URL=postgresql://user:pass@localhost:5432/reverie

# Redis
REDIS_URL=redis://localhost:6379

# Storage
STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=/mnt/nas/reverie

# S3 (optional, if STORAGE_PROVIDER=s3)
STORAGE_S3_BUCKET=reverie
STORAGE_S3_ENDPOINT=http://localhost:9000
STORAGE_S3_ACCESS_KEY=minioadmin
STORAGE_S3_SECRET_KEY=minioadmin

# Anthropic (Claude) / LLM
ANTHROPIC_API_KEY=sk-ant-...
# Per-document summarization + image vision (high-volume, cheap)
ANTHROPIC_SUMMARY_MODEL=claude-haiku-5-5
ANTHROPIC_VISION_MODEL=claude-haiku-5-5
# Thinking depth for summaries/vision (Haiku 5.x only): low | medium | high
ANTHROPIC_SUMMARY_EFFORT=low

# In-app agent (admin-only chat on stock Claude Code, see README "In-app agent").
# Dev: `docker compose up reverie-agent` publishes the wrapper on localhost:8080 with this shared secret.
# In production the backend generates the secret itself (AGENT_SECRET_FILE in docker-compose.prod.yml).
AGENT_URL=http://localhost:8080
AGENT_SECRET=reverie-dev-agent-secret

# Trash retention in days (1-3650). Default for the admin-editable `trash.retentionDays` setting.
TRASH_RETENTION_DAYS=30

# Server
PORT=3000
HOST=0.0.0.0

# CORS (HTTP API, comma-separated origins)
CORS_ORIGIN=http://localhost:5173

# WebSocket
WS_ENABLED=true
WS_CORS_ORIGIN=http://localhost:5173

# OCR
# PaddleOCR inference device: cpu (default) or gpu:0 on a CUDA host (RTX 3080 etc.).
# Requires the GPU image build (OCR_GPU=true) + NVIDIA Container Toolkit on the host.
OCR_DEVICE=cpu

# Job Queue
JOB_CONCURRENCY_OCR=2
JOB_CONCURRENCY_THUMBNAIL=4
JOB_CONCURRENCY_LLM=1
# Background documents (a phone's photo backup) have their own OCR, thumbnail and video transcode lanes. An OCR or
# thumbnail job in them starts only while no normal job of its kind is waiting or running.
JOB_CONCURRENCY_OCR_BACKGROUND=1
JOB_CONCURRENCY_THUMBNAIL_BACKGROUND=1
# The background transcode's ffmpeg runs under `nice` at this level (0-19, higher yields more) with its decoder, filters
# and each rendition's encoder capped to this many threads.
JOB_CONCURRENCY_TRANSCODE_BACKGROUND=1
TRANSCODE_BACKGROUND_NICE=10
TRANSCODE_BACKGROUND_THREADS=2
# How many NVENC encodes the graphics card runs at once (each rendition is one). The normal lane keeps three per video it
# can encode at once; a background video uses the card only if all its renditions fit in the rest, else the CPU.
TRANSCODE_NVENC_SESSION_LIMIT=5
JOB_RETRY_ATTEMPTS=3
JOB_RETRY_BACKOFF_MS=5000

# LLM Processing
LLM_ENABLED=true
LLM_MAX_INPUT_CHARS=50000
LLM_SNIPPET_SIZE=5000
LLM_PROCESS_CODE_FILES=false
LLM_MIN_OCR_CONFIDENCE=30
# Output budget for per-document summary/vision calls (thinking headroom is added on top in code)
LLM_MAX_OUTPUT_TOKENS=2000

# Image call (optional): screenshots and document images (never photos) are sent to Claude together with their OCR text.
# Model set via ANTHROPIC_VISION_MODEL. Off by default; without it those images get a text summary when their OCR text qualifies, and nothing otherwise.
# Only the default: the admin settings page ("AI providers") holds the live switch.
LLM_VISION_ENABLED=false

# Local LLM provider (optional): summaries and the image call can instead go to a server behind an OpenAI-compatible
# endpoint (Ollama, llama.cpp, vLLM, LM Studio). Pick the provider, model and base URL per capability on the admin settings
# page, not here. The key, when the server wants one, stays in the environment and is never stored in the database.
# LOCAL_LLM_API_KEY=
# How long one request to the local server may take before it counts as failed (a local model can be slow).
LOCAL_LLM_TIMEOUT_MS=120000

# File serving (signed URLs for nginx secure_link)
FILE_URL_SECRET=your-32-char-secret-change-this
FILE_URL_EXPIRES_SECONDS=3600

# JWT Authentication
JWT_SECRET=your-secret-key-here-at-least-32-characters-long
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# External sign-in with OpenID Connect (optional). Password sign-in always works.
# Any standard provider (Authentik, Keycloak, Authelia, ...) is a JSON entry; the redirect URI
# to register at the provider is <API_PUBLIC_URL>/auth/oidc/<id>/callback unless "redirectUri" is given.
# Fields: id (lowercase letters, digits, dashes), name (button label), issuer, clientId, clientSecret,
# optional scopes (default ["openid","email","profile"]) and redirectUri.
# OIDC_PROVIDERS=[{"id":"authentik","name":"Authentik","issuer":"https://auth.example.com/application/o/reverie/","clientId":"...","clientSecret":"..."}]
# The address the browser reaches this API at (used to build redirect URIs). Default: http://localhost:$PORT.
# MCP upload commands use it too; unset, they use the address the /mcp request came in on. Set it if a proxy
# serves the API under a path prefix.
# API_PUBLIC_URL=https://api.example.com

# Google. These three variables alone add a "google" provider (issuer https://accounts.google.com);
# GOOGLE_CALLBACK_URL is the redirect URI registered at Google (it must end in /auth/google/callback
# or /auth/oidc/google/callback).
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
